{
    "mssql.intelliSense.enableErrorChecking": false,
    "mssql.intelliSense.enableIntelliSense": false,
    "files.associations": {
        "*.sql": "plaintext"
    },
    "css.lint.vendorPrefix": "ignore",
    "scss.lint.vendorPrefix": "ignore",
    "less.lint.vendorPrefix": "ignore",
    "intelephense.diagnostics.duplicateSymbols": false,
    "intelephense.diagnostics.undefinedVariables": "off",
    "intelephense.diagnostics.undefinedProperties": false
}
